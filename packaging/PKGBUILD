# Maintainer: obscura
# Lives in packaging/ so makepkg's src/ and pkg/ scratch folders never touch the Rust src/.
pkgname=vox-pro
pkgver=0.3.2
pkgrel=1
pkgdesc='Voice and audio mixer for PipeWire, with 8 strips, EQ, compressors, limiters and recording (Voicemeeter Potato style)'
arch=('x86_64')
license=('custom')
depends=('pipewire' 'wireplumber' 'qt6-base' 'qt6-declarative' 'libnotify' 'soundtouch' 'curl' 'polkit' 'lilv' 'kwindowsystem')
makedepends=('cargo' 'clang' 'cmake')
optdepends=('lsp-plugins-lv2: a large set of LV2 effects for the plugin rack' 'lsp-plugins-clap: the same effects as CLAP' 'lsp-plugins-vst3: the same effects as VST3' 'dragonfly-reverb-vst3: reverbs (VST3)' 'calf: LV2 effects (reverb, de-esser and more)' 'x42-plugins: LV2 effects')
# makepkg's LTO flags don't mix well with the Rust + C++ (cxx-qt) build.
options=('!lto' '!debug')
source=()

build() {
  cd "$startdir/.."
  # Build for any x86-64 CPU, not just this machine's. makepkg.conf on CachyOS adds -march=native
  # and target-cpu=native, which put AVX-512 into the binary: it then dies with SIGILL
  # (illegal instruction) on CPUs without it.
  export CFLAGS="$(sed -E 's/-m(arch|tune)=[^ ]+//g' <<<"$CFLAGS") -march=x86-64 -mtune=generic"
  export CXXFLAGS="$(sed -E 's/-m(arch|tune)=[^ ]+//g' <<<"$CXXFLAGS") -march=x86-64 -mtune=generic"
  export RUSTFLAGS="$(sed -E 's/-C ?target-cpu=[^ ]+//g' <<<"$RUSTFLAGS") -C target-cpu=x86-64"
  cargo build --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/vox-pro "$pkgdir/usr/bin/vox-pro"
  install -Dm644 packaging/vox-pro.desktop "$pkgdir/usr/share/applications/vox-pro.desktop"
  install -Dm644 packaging/vox-pro.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vox-pro.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.txt"
}
